# ---------- App ----------
APP_NAME="SEO Agent"
APP_URL=http://localhost:3000
NODE_ENV=development
ADMIN_EMAILS=you@example.com
CRAWLER_USER_AGENT="SEOAgentBot/1.0 (+http://localhost:3000/bot)"

# ---------- Database / queue / storage ----------
DATABASE_URL=postgres://postgres:postgres@localhost:5432/seo_agent
REDIS_URL=redis://localhost:6379
S3_ENDPOINT=
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# 32 random bytes, base64:  node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
ENCRYPTION_KEY=

# ---------- Auth ----------
AUTH_SECRET=
GOOGLE_LOGIN_CLIENT_ID=
GOOGLE_LOGIN_CLIENT_SECRET=

# ---------- Google data APIs (separate OAuth client recommended) ----------
GOOGLE_DATA_CLIENT_ID=
GOOGLE_DATA_CLIENT_SECRET=
GOOGLE_DATA_REDIRECT_URI=http://localhost:3000/api/integrations/google/callback
PAGESPEED_API_KEY=
FEATURE_GBP=false

# ---------- AI (OpenRouter) ----------
OPENROUTER_API_KEY=
# Check current slugs on https://openrouter.ai/models
MODEL_CHEAP=deepseek/deepseek-v4.1-flash
MODEL_VISION=google/gemini-3.7-flash
MODEL_MID=google/gemini-3.7-flash
MODEL_PREMIUM=
MODEL_FALLBACK=openai/gpt-oss-120b
LLM_BUDGET_PER_SITE_USD=5

# ---------- SEO data ----------
DATAFORSEO_LOGIN=
DATAFORSEO_PASSWORD=

# ---------- Billing ----------
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_MONTHLY=
STRIPE_PRICE_YEARLY=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# ---------- Email ----------
EMAIL_PROVIDER=resend
RESEND_API_KEY=
EMAIL_FROM="SEO Agent <hello@example.com>"

# ---------- Connectors ----------
SHOPIFY_API_KEY=
SHOPIFY_API_SECRET=
SHOPIFY_API_VERSION=
SHOPIFY_SCOPES=read_products,write_products,read_content,write_content,read_online_store_navigation,write_online_store_navigation,read_themes
WEBFLOW_CLIENT_ID=
WEBFLOW_CLIENT_SECRET=
GITHUB_APP_ID=
GITHUB_APP_PRIVATE_KEY=
GITHUB_APP_WEBHOOK_SECRET=
GITHUB_APP_SLUG=

# ---------- Abuse protection ----------
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# ---------- Monitoring ----------
SENTRY_DSN=
NEXT_PUBLIC_POSTHOG_KEY=
