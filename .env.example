# ---------- Core ----------
APP_URL=http://localhost:3000
# Comma-separated emails that can open /admin
ADMIN_EMAILS=
# 32 random bytes, base64:  node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
ENCRYPTION_KEY=
# Leave empty to use the built-in PGlite database (./data/pglite). Set for production, e.g. Neon.
DATABASE_URL=

# ---------- AI (OpenRouter) ----------
OPENROUTER_API_KEY=
# Check current model slugs on https://openrouter.ai/models
MODEL_CHEAP=deepseek/deepseek-v4.1-flash
MODEL_FALLBACK=google/gemini-3.7-flash
LLM_BUDGET_PER_SITE_USD=5

# ---------- Crawler / worker ----------
CRAWLER_USER_AGENT="SEOAgentBot/1.0 (+http://localhost:3000/bot)"
WORKER_CONCURRENCY=2
WORKER_ENABLED=true

# ---------- Email (Resend). Empty = emails are printed to the server log ----------
RESEND_API_KEY=
EMAIL_FROM="SEO Agent <hello@example.com>"
